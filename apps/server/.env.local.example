HOST=0.0.0.0
PORT=4000

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="mysql://root:123456@127.0.0.1:3306/wewe-rss"

# 使用Sqlite
# DATABASE_URL="file:../data/wewe-rss.db"
# DATABASE_TYPE="sqlite"

# 访问授权码
AUTH_CODE=123567

# 每分钟最大请求次数
MAX_REQUEST_PER_MINUTE=60

# 自动提取全文内容
FEED_MODE="fulltext"

# nginx 转发后的服务端地址
SERVER_ORIGIN_URL=http://localhost:4000

# 定时更新订阅源Cron表达式
CRON_EXPRESSION="35 5,17 * * *"

# 是否开启正文html清理
ENABLE_CLEAN_HTML=false

# 连续更新延迟时间(秒)
UPDATE_DELAY_TIME=60

# 读书转发服务，不需要修改
PLATFORM_URL="https://weread.111965.xyz"

# 账号提供器：remote 保留原转发服务；local 在当前服务扫码并自动续期
WEREAD_ACCOUNT_PROVIDER="local"

# 本地微信读书会话加密密钥，生产环境请替换为随机长字符串
WEREAD_SESSION_SECRET="change-me-to-a-random-secret"

# 本地微信读书会话主动续期间隔（小时）
WEREAD_RENEW_INTERVAL_HOURS=6

# 微信读书 Web 地址，一般无需修改
WEREAD_BASE_URL="https://weread.qq.com"
